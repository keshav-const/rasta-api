# Copy to .env and fill in. .env is gitignored and never enters the Docker image.

# HTTP port. Locally defaults to 8080; on Render/most PaaS this is injected, leave unset.
PORT=8080

# Supabase Postgres connection string — use the IPv4 SESSION POOLER URL
# (Supabase dashboard > Project Settings > Database > Connection string > "Session pooler"),
# NOT the direct IPv6 endpoint. Looks like:
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
