{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "A provenance-first cultural data API for India: 4,900+ creator-verified places and living traditions where every claim cites its source. Each entity carries a trust signal (how well-corroborated) and, where applicable, a freshness signal (how current). Supports geo (near/bbox) and fuzzy search.",
        "title": "Rasta API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/healthz": {
            "get": {
                "description": "Returns ok, and 503 if the database is unreachable.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Liveness \u0026 readiness",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_keshav-const_rasta-api_internal_httpx.Envelope"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/github_com_keshav-const_rasta-api_internal_httpx.Envelope"
                        }
                    }
                }
            }
        },
        "/v1/cities": {
            "get": {
                "description": "Cities/regions with a live count of the active entities anchored to each, busiest first.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cities"
                ],
                "summary": "Destinations with live entity counts",
                "parameters": [
                    {
                        "type": "string",
                        "description": "e.g. India",
                        "name": "country",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "city | region",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "name search",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "only destinations with \u003e= N entities",
                        "name": "min_places",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "page size (\u003c=100)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "page offset",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_keshav-const_rasta-api_internal_httpx.Envelope"
                        }
                    }
                }
            }
        },
        "/v1/entities": {
            "get": {
                "description": "Without type=: the taxonomy (each entity_type + count) for category discovery. With type=\u003ct\u003e: entities of that type, using the same filters/paging as /v1/places.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "entities"
                ],
                "summary": "Entity taxonomy, or entities of a type",
                "parameters": [
                    {
                        "type": "string",
                        "description": "entity_type to list; omit for the taxonomy",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "fuzzy name search",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "min distinct sources",
                        "name": "min_sources",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "min distinct platforms",
                        "name": "min_platforms",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "drop stale volatile places",
                        "name": "fresh_only",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "lat,lng for radius search",
                        "name": "near",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "radius (km) for near=",
                        "name": "radius_km",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "minLng,minLat,maxLng,maxLat",
                        "name": "bbox",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "trust | freshness",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "page size (\u003c=100)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "page offset",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_keshav-const_rasta-api_internal_httpx.Envelope"
                        }
                    }
                }
            }
        },
        "/v1/places": {
            "get": {
                "description": "Ranked list of places and cultural entities. Each item carries a trust object and, where applicable, a freshness object. Supports geo (near/bbox) and fuzzy search.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "places"
                ],
                "summary": "List \u0026 filter entities",
                "parameters": [
                    {
                        "type": "string",
                        "description": "destination slug (e.g. jaipur)",
                        "name": "city",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "e.g. India",
                        "name": "country",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "poi_category (e.g. temple, restaurant)",
                        "name": "category",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "entity_type (poi, festival, sport, cuisine, ...)",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "fuzzy name search (typo-tolerant, ranked)",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "only entities backed by \u003e= N distinct sources",
                        "name": "min_sources",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "only entities across \u003e= N distinct platforms",
                        "name": "min_platforms",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "drop entities whose newest source is older (enduring types exempt)",
                        "name": "max_source_age_days",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "drop entities whose freshness would be stale (band-aware)",
                        "name": "fresh_only",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "lat,lng for radius search",
                        "name": "near",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "radius (km) for near=",
                        "name": "radius_km",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "minLng,minLat,maxLng,maxLat (map viewport)",
                        "name": "bbox",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "trust | freshness (default: recommendation score)",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "page size (\u003c=100, default 20)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "page offset",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_keshav-const_rasta-api_internal_httpx.Envelope"
                        }
                    }
                }
            }
        },
        "/v1/places/{slug}": {
            "get": {
                "description": "The product's moat: returns the entity plus every source backing it (platform, title, url, creator, date), each with its stance and raw claims.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "places"
                ],
                "summary": "One place with all its sourced evidence (\"receipts\")",
                "parameters": [
                    {
                        "type": "string",
                        "description": "entity slug",
                        "name": "slug",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_keshav-const_rasta-api_internal_httpx.Envelope"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/github_com_keshav-const_rasta-api_internal_httpx.Envelope"
                        }
                    }
                }
            }
        },
        "/v1/stats": {
            "get": {
                "description": "Totals for places, cities, sources and claims.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Headline graph counts",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_keshav-const_rasta-api_internal_httpx.Envelope"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_keshav-const_rasta-api_internal_httpx.APIError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "github_com_keshav-const_rasta-api_internal_httpx.Envelope": {
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "$ref": "#/definitions/github_com_keshav-const_rasta-api_internal_httpx.APIError"
                },
                "meta": {}
            }
        }
    }
}